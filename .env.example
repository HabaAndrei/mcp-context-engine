# Copy to .env and edit. Values here are placeholders, not defaults to keep.

# Which database to use: "sqlite" or "postgres".
CON_MCP_DB_TYPE=sqlite

# MCP transport: "stdio" (for desktop clients) or "http".
CON_MCP_TRANSPORT=stdio

# --- SQLite (used when CON_MCP_DB_TYPE=sqlite) ---
CON_MCP_SQLITE_PATH=./data.db

# --- PostgreSQL (all five required when CON_MCP_DB_TYPE=postgres) ---
# Set a real password before using this; do not commit the filled-in .env.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=context_mcp
